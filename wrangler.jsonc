{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-evolution",
  "account_id": "e4a3fdbae140dc1895528888a3a723c5",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "jev.chizi.app", "custom_domain": true }]
}
